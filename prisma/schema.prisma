// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?        // Untuk Credentials login
  role          Role           @default(USER)
  accounts      Account[]
  sessions      Session[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StoreSetting {
  key   String @id
  value String
}

model MarginTier {
  id    Int    @id @default(autoincrement())
  min   Float
  max   Float?
  pct   Float
}

model Category {
  id        String     @id @default(uuid())
  cjId      String?    @unique // ID kategori dari CJ
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id           String    @id @default(uuid())
  cjId         String    @unique
  name         String
  description  String?   @db.Text
  images       String[]
  categoryId   String?   // Relation to Category table (optional/legacy)
  cjCategoryId String?   // Direct CJ Category ID string
  category     Category? @relation(fields: [categoryId], references: [id])
  variantCount Int       @default(0)
  totalStock   Int       @default(0)
  variants     Variant[]
  status       String    @default("ACTIVE")
  isHero       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Variant {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cjId         String      @unique
  sku          String
  color        String?
  size         String?
  weight       Float
  baseCost     Float       // Harga asli CJ (bulatkan ke 2 desimal di aplikasi)
  sellingPrice Float       // Harga jual setelah markup (bulatkan ke 2 desimal)
  inventory    Int         @default(0)
  image        String?
  orderItems   OrderItem[]
}

model ShippingMethod {
  id           String   @id @default(uuid())
  cjMethodName String   @unique // e.g. "CJ Packet Sensitive"
  displayName  String?  // Nama yang tampil di user
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderNum        String      @unique // Format: ORD-2024-XXXX
  checkoutToken   String?     @unique // 64-char unique token for secure access
  cjOrderId       String?     @unique
  userId          String?
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json?       // PostgreSQL JSONB
  items           OrderItem[]
  totalAmount     Float?
  shippingFee     Float?      @default(0)
  costAmount      Float?      // Harga modal dari CJ
  status          String      @default("UNPAID") // UNPAID, PAID, FULFILLING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus   String?
  emailSent       Boolean     @default(false)
  waSent          Boolean     @default(false)
  trackingNumber  String?
  orderData       Json?       // Data mentah payload
  cjResponse      Json?       // Respons mentah dari CJ
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float
}

model WebhookLog {
  id        String   @id @default(cuid())
  eventType String?
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())
}

model PricingTier {
  id            String   @id @default(cuid())
  minPrice      Float    // Modal minimal (USD)
  maxPrice      Float?   // Modal maksimal (USD), null berarti tak terbatas
  marginPercent Float    // Persentase margin (misal: 70 berarti +70%)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CartItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pid            String
  vid            String?
  sku            String?
  variantName    String?
  productName    String
  productNameEn  String?
  productImage   String?
  bigImage       String?
  sellPrice      Float
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, pid, vid])
}

model WishlistItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pid            String
  productName    String?
  productNameEn  String?
  productImage   String?
  bigImage       String?
  sellPrice      Float?
  categoryName   String?
  createdAt      DateTime @default(now())

  @@unique([userId, pid])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?  @db.Text
  content   String   @db.Text
  image     String?
  author    String   @default("Admin")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutPage {

  id        String   @id @default(cuid())
  title     String   @default("About Us")
  content   String   @db.Text
  image     String?
  mission   String?  @db.Text
  vision    String?  @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutoImportState {
  id              String   @id @default("default")
  currentCategory String?  
  currentPage     Int      @default(1)
  status          String   @default("IDLE") 
  updatedAt       DateTime @updatedAt
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String            // PERCENTAGE, FIXED, FREE_SHIPPING
  value         Float
  description   String?
  minPurchase   Float?
  maxUses       Int?
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  products      CouponProduct[]
}

model CouponProduct {
  id          String @id @default(cuid())
  couponId    String
  productCjId String
  coupon      Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  
  @@unique([couponId, productCjId])
}

